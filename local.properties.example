# Copy this file to local.properties and (optionally) override the backend URL.
# local.properties is gitignored — it never gets committed.
#
# The Android app talks ONLY to the backend over HTTPS. No Turso/libSQL
# database token is embedded in the APK — the backend owns the database,
# caching and security, and authenticates every request with a short-lived JWT.
#
# BACKEND_URL is the absolute API root (the deployed Hugging Face Space).

BACKEND_URL=https://amer585-intlaqa-backend.hf.space/api
